WEB_FIREBASE_KEY=replace_with_web_firebase_api_key
ANDROID_FIREBASE_KEY=replace_with_android_firebase_api_key
IOS_FIREBASE_KEY=replace_with_ios_firebase_api_key
MACOS_FIREBASE_KEY=replace_with_macos_firebase_api_key
WINDOWS_FIREBASE_KEY=replace_with_windows_firebase_api_key
FIREBASE_RTDB_URL=replace_with_firebase_realtime_database_url

# WebSocket Server URL for CRDT live sync and offline queue
# Use http://10.0.2.2:3000 for Android emulator, http://localhost:3000 for web/desktop, or your deployed server URL
WEBSOCKET_URL=http://10.0.2.2:3000

# Cloudflare R2 Configuration for Profile Photo Storage
# Replace these placeholders with your actual Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=placeholder_account_id
CLOUDFLARE_R2_ACCESS_KEY=placeholder_access_key
CLOUDFLARE_R2_SECRET_KEY=placeholder_secret_key
CLOUDFLARE_R2_BUCKET=placeholder_bucket_name
CLODFLARE_R2_PUBLIC_URL=placeholder_public_url

# Agora Voice Calling & Chat SDK
# AGORA_APP_ID is required for voice calling & chat (Client requires App ID)
AGORA_APP_ID=placeholder_agora_app_id
# Optional Agora Chat configuration (if omitted, chat operates in local-first/offline mode)
# AGORA_CHAT_APP_KEY=placeholder_agora_chat_app_key
# AGORA_CHAT_TOKEN=placeholder_server_or_user_chat_token
