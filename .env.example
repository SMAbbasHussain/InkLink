WEB_FIREBASE_KEY=replace_with_web_firebase_api_key
ANDROID_FIREBASE_KEY=replace_with_android_firebase_api_key
IOS_FIREBASE_KEY=replace_with_ios_firebase_api_key
MACOS_FIREBASE_KEY=replace_with_macos_firebase_api_key
WINDOWS_FIREBASE_KEY=replace_with_windows_firebase_api_key
FIREBASE_RTDB_URL=replace_with_firebase_realtime_database_url

# WebSocket Server URL for CRDT live sync and offline queue
# Use http://10.0.2.2:3000 for Android emulator, http://localhost:3000 for web/desktop, or your deployed server URL
WEBSOCKET_URL=http://10.0.2.2:3000

# Cloudflare R2 Configuration for Profile Photo Storage
# Replace these placeholders with your actual Cloudflare credentials
CLOUDFLARE_ACCOUNT_ID=placeholder_account_id
CLOUDFLARE_R2_ACCESS_KEY=placeholder_access_key
CLOUDFLARE_R2_SECRET_KEY=placeholder_secret_key
CLOUDFLARE_R2_BUCKET=placeholder_bucket_name
CLOUDFLARE_R2_PUBLIC_URL=placeholder_public_url

# Agora Voice Calling (RTC)
# AGORA_APP_ID is required for real-time voice. RTC/Chat tokens are minted
# server-side by the InkLink server (see server/.env.example for the full set
# of AGORA_* server variables) — no chat tokens or app keys live in the client.
AGORA_APP_ID=placeholder_agora_app_id

# AI image generation feature switch (not a secret).
# true  = the canvas Media tray can generate and edit images with AI.
# false or missing = the tray shows the old "coming soon" message.
# The AI provider key is NOT configured here. It lives only in Firebase
# Functions secrets (see AI_SETUP.md).
AI_IMAGE_ENABLED=true

# DEBUG BUILDS ONLY: send the three AI callables to the Functions emulator on
# your PC instead of the deployed functions (see AI_SETUP.md section 4c).
# Release builds ignore these. Leave them commented out normally.
# USE_FUNCTIONS_EMULATOR=true
# FUNCTIONS_EMULATOR_HOST=127.0.0.1
# FUNCTIONS_EMULATOR_PORT=5001
