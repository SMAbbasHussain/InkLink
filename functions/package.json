    "dotenv": "^17.3.1",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "glob": "^13.0.6",
    "ioredis": "^6.0.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1"
  },
