# ============================================================
# InkLink server environment — copy to server/.env (never commit it)
# ============================================================

# Redis (required)
REDIS_URL=redis://127.0.0.1:6379

# Firebase Admin — one of the following (see src/index.js loadFirebaseServiceAccount)
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=
# SERVICE_ACCOUNT_PATH=

# --- Agora RTC (voice channels board_<boardId>) ---
# AGORA_APP_ID is required to issue voice tokens; AGORA_APP_CERTIFICATE is
# required to mint REAL RTC tokens (join_voice_call and /api/agora/rtc/token
# reject with 'agora certificate not configured' without it).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Agora Chat (server-side only, never shipped to clients) ---
# REST base: copy the exact REST API URL shown in the Agora Console for your
# Chat app. Legacy apps use https://a1.easemob.com; newer apps are hosted at
# https://a???.chat.agora.io (e.g. https://a61.chat.agora.io). The console URL
# usually includes your org/app path segments: {base}/{ORG}/{APP}.
# CLIENT_ID/CLIENT_SECRET come from Agora Console → Project → Chat → Overview.
AGORA_CHAT_REST_BASE=https://a61.chat.agora.io
AGORA_CHAT_ORG_NAME=
AGORA_CHAT_APP_NAME=
AGORA_CHAT_REST_CLIENT_ID=
AGORA_CHAT_REST_CLIENT_SECRET=

# Lifetime of per-user Chat tokens minted by POST /api/agora/chat/token
# (hours; default 24).
AGORA_CHAT_TOKEN_EXPIRY_HOURS=24

# --- Board (canvas) chat history ---
# Retention for the Redis history list (days; default 90).
# NOTE: Redis persistence (AOF) must be enabled or chat history is lost on restart.
BOARD_CHAT_HISTORY_TTL_DAYS=90
