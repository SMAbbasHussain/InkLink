PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Firebase Admin credentials. Use ONE of the following in Render:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoi... (base64-encoded JSON)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json (path-based only)
# SERVICE_ACCOUNT_PATH=service-account.json (local dev fallback)

# Agora In-Session Voice Calling
AGORA_APP_ID=placeholder_agora_app_id
AGORA_APP_CERTIFICATE=placeholder_agora_app_certificate
